# 윈도우가 자동으로 만드는 파일
Thumbs.db
desktop.ini
ehthumbs.db

# 맥이 자동으로 만드는 파일
.DS_Store

# 오피스(한글/워드/엑셀) 임시 파일
~$*
*.tmp

# 기록 파일
*.log

# 비밀 값이 든 파일 — 절대 올리지 않는다 (API 키 등)
.env
.env.*
!.env.example

# 내려받은 동영상·음성 — 용량이 커서 올리지 않는다 (yt-dlp 로 다시 받으면 된다)
*.mp4
*.mp3
*.webm
*.m4a

# 개발 도구가 만드는 폴더
node_modules/
__pycache__/
.venv/
dist/
build/

# 클로드 코드 폴더 — 내가 만든 스킬만 올린다
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/recipe/
!.claude/skills/youtube-summary/
